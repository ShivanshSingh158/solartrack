{
  "name": "waaree-solartrack",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node apps/server/src/server.js",
    "dev": "node apps/server/src/server.js",
    "dev:server": "node apps/server/src/server.js",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck && npx --prefix apps/web tsc -p packages/solar-core/tsconfig.json --noEmit",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs tests/e2e/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run build",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios"
  }
}
